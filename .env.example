# ─── Core ───
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
APP_NAME=NovaPanel

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://novapanel:novapanel@localhost:55432/novapanel?schema=public

# ─── Redis ───
REDIS_URL=redis://localhost:56379

# ─── JWT ───
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=NovaPanel
JWT_AUDIENCE=NovaPanel-web

# ─── Auth ───
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=10
ACCOUNT_LOCK_MINUTES=15
VERIFICATION_TOKEN_TTL_MINUTES=60

# ─── SMTP / Email ───
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=NovaPanel <noreply@novapanel.dev>

# ─── Storage ───
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# ─── Payments ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYTR_MERCHANT_ID=
PAYTR_SECRET_KEY=
PAYTR_WEBHOOK_SECRET=
PAYMENT_METHODS=wallet,balance,mock

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ─── Admin bootstrap ───
ADMIN_EMAIL=admin@novapanel.dev
ADMIN_PASSWORD=Admin1234!
SEED_ON_START=false
